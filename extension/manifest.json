{
  "manifest_version": 3,
  "name": "ZenOS Bridge — SmartBiz & Wukusy",
  "version": "2.2.0",
  "description": "Seamless 1-Click Order Sync from Amazon SmartBiz to ZenOS WhatsApp Automation and 1-Tap Autofill to Wukusy Fulfillment.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "ZenOS Core Bridge"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.smartbiz.amazon.in/*",
    "*://smartbiz.amazon.in/*",
    "*://*.wukusy.com/*",
    "*://wukusy.com/*",
    "*://*.wukusy.app/*",
    "*://wukusy.app/*",
    "*://*.deodap.com/*",
    "*://deodap.com/*",
    "*://*.vercel.app/*",
    "*://*.onrender.com/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://smartbiz.amazon.in/*",
        "*://*.smartbiz.amazon.in/*"
      ],
      "js": ["smartbiz_bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.wukusy.com/*",
        "*://wukusy.com/*",
        "*://*.wukusy.app/*",
        "*://wukusy.app/*",
        "*://*.deodap.com/*",
        "*://deodap.com/*"
      ],
      "js": ["wukusy_bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
